{
  "mock_mode": false,
  "button_debounce": 0.02,
  "buttons": {
    "1": {
      "label": "SCREEN",
      "event": "right",
      "pin": 19
    },
    "2": {
      "label": "SCROLL",
      "event": "down",
      "pin": 20
    },
    "3": {
      "label": "SELECT",
      "event": "run",
      "pin": 21
    }
  },
  "input_mapping": {
    "left": {
      "action": "navigate",
      "delta": -1
    },
    "right": {
      "action": "navigate",
      "delta": 1
    },
    "up": {
      "home": "none",
      "music": "volume_up",
      "agents": "select_prev",
      "tasks": "select_prev"
    },
    "down": {
      "home": "none",
      "music": "volume_down",
      "agents": "select_next",
      "tasks": "select_next"
    },
    "press": {
      "home": "run_workflow",
      "music": "play_pause",
      "agents": "run_workflow",
      "tasks": "run_workflow"
    },
    "run": {
      "home": "run_workflow",
      "music": "run_workflow",
      "agents": "run_workflow",
      "tasks": "run_workflow"
    },
    "approve": {
      "home": "none",
      "music": "next_track",
      "agents": "run_workflow",
      "tasks": "run_workflow"
    },
    "stop": {
      "home": "none",
      "music": "previous_track",
      "agents": "none",
      "tasks": "none"
    },
    "voice": {
      "home": "none",
      "music": "none",
      "agents": "none",
      "tasks": "none"
    }
  },
  "ui": {
    "wallpaper": "/static/wallpapers/default.svg",
    "clock_24h": false
  },
  "music": {
    "auto_open": true,
    "poll_seconds": 1.5,
    "mock_track_seconds": 210
  },
  "display": {
    "model": "MPI3501",
    "resolution": [
      480,
      320
    ],
    "rotation": 90,
    "overlay": "tft35a",
    "touch_controller": "XPT2046",
    "conflicting_gpio": [
      7,
      8,
      9,
      10,
      11,
      17,
      24,
      25
    ],
    "requires_stack_through_header": true
  },
  "sensors": {
    "type": "auto",
    "dht_gpio": 4,
    "dht22_gpio": 4,
    "stale_seconds": 30
  },
  "workflows": [
    {
      "label": "Daily Brief",
      "description": "Kickstart your day: AI calendar, priority tasks & intelligence briefing",
      "category": "Daily",
      "webhook": "https://n8n.crellocrm.com/webhook/daily-brief",
      "method": "POST",
      "timeout": 30
    }
  ]
}